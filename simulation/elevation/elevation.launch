<launch>
  <!-- 独立启动 elevation_mapping：MID360 点云 + TF → 2.5D 高程图 -->
  <!-- 前置：需 source elevation_ws/devel/setup.bash，且 TF 树 world→base→mid360 已存在 -->
  <arg name="cfg_dir" default="$(env HOME)/claude/raicom/go2-scan/simulation/elevation"/>

  <node pkg="elevation_mapping" type="elevation_mapping" name="elevation_mapping" output="screen">
    <rosparam command="load" file="$(arg cfg_dir)/mid360_robot.yaml"/>
    <rosparam command="load" file="$(arg cfg_dir)/elevation_map.yaml"/>
  </node>
</launch>
