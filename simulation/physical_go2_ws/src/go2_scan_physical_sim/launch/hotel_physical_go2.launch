<launch>
  <!--
    Isolated physical Go2 backend.  Do not include scan_planner's gazebo_sim
    launch here: it has another package named go2_description and a kinematic
    SetWorldPose body writer.
  -->
  <arg name="world_file"/>
  <arg name="init_x" default="0.0"/>
  <arg name="init_y" default="0.0"/>
  <arg name="init_z" default="1.0"/>
  <arg name="init_yaw" default="0.0"/>
  <arg name="gui" default="true"/>
  <!-- Spawn gate releases physics only after hotel and Go2 are both complete. -->
  <arg name="paused" default="true"/>
  <arg name="debug" default="false"/>
  <arg name="model_name" default="go2_gazebo"/>

  <arg name="auto_getup" default="true"/>
  <arg name="world_stable_seconds" default="3.0"/>
  <arg name="render_sync_grace_seconds" default="3.0"/>

  <param name="robot_name" type="str" value="go2"/>
  <param name="ros_namespace" type="str" value="/go2_gazebo/"/>
  <param name="gazebo_model_name" type="str" value="$(arg model_name)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_file)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="debug" value="$(arg debug)"/>
  </include>

  <param name="robot_description"
         command="$(find xacro)/xacro --inorder '$(find go2_description)/xacro/robot.xacro'"/>

  <node pkg="go2_scan_physical_sim" type="spawn_physical_go2.py"
        name="physical_go2_spawn_gate" output="screen" required="true">
    <param name="model_name" value="$(arg model_name)"/>
    <param name="x" value="$(arg init_x)"/>
    <param name="y" value="$(arg init_y)"/>
    <param name="z" value="$(arg init_z)"/>
    <param name="yaw" value="$(arg init_yaw)"/>
    <param name="world_stable_seconds" value="$(arg world_stable_seconds)"/>
    <param name="render_sync_grace_seconds" value="$(arg render_sync_grace_seconds)"/>
    <rosparam param="required_world_models">[hotel_L1, hotel_stair1, hotel_stair2]</rosparam>
  </node>

  <!-- Gazebo's controller manager consumes this after the robot is spawned. -->
  <rosparam file="$(find go2_description)/config/robot_control.yaml" command="load"/>

  <node pkg="robot_state_publisher" type="robot_state_publisher"
        name="physical_go2_state_publisher" output="screen">
    <remap from="/joint_states" to="/go2_gazebo/joint_states"/>
  </node>

  <node pkg="rl_sar" type="rl_sim" name="rl_sar" output="screen" required="true">
    <param name="auto_getup" value="$(arg auto_getup)"/>
    <param name="auto_getup_settle_seconds" value="1.0"/>
    <param name="auto_getup_max_body_z" value="0.20"/>
  </node>

</launch>
