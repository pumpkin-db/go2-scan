<?xml version="1.0" ?>
<sdf version="1.6">
  <!-- Depot 场景（DARPA SubT 仓库，Ignition 模型 → 经典 Gazebo9 转换版）。
       转换：scenes/gtools/sdf_add_collisions.py 给 WALLS/FLOOR/STAIRS/PILLERS/BOXSET/ROOF
       补了 collision（原模型除地面外全无 collision，雷达射线打不到墙）；
       static=true；去 ignition 插件与风扇关节。
       使用：GAZEBO_MODEL_PATH 需含 go2-scan/scenes/depot/model（见 launch_gazebo_sim.sh）。 -->
  <world name="depot">
    <include>
      <uri>model://sun</uri>
    </include>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.55 0.6 0.7 1</background>
      <shadows>false</shadows>
    </scene>
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <include>
      <uri>model://Depot</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
