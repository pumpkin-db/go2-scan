<launch>
  <!-- ============================================================ -->
  <!-- Gazebo 场景仿真：indoor_1.world + Go2 狗 + mid360 LiDAR     -->
  <!--   mid360 插件出 /mid360_points（传感器坐标）              -->
  <!--   Go2 ModelPlugin 在 WorldUpdate 内积分 /cmd_vel、更新模型并发布 pose -->
  <!-- ============================================================ -->

  <arg name="world_file" default="$(env HOME)/claude/raicom/go2-scan/simulation/worlds/indoor_1.world"/>
  <arg name="navi_mode" default="1"/>
  <!-- 全局决策层选择：tare（默认）| ariadne | none。
       none = 纯底盘+传感链（无全局决策核）：B 验收（terrain_follow 遥控上台阶）、
       传感器链路调试、D 组件 climb_mode 单测的干净底座。FSM 由 navi_mode 直接
       驱动（=1 等外部单点目标、=2 吃 scan_planner/tools/keypoint.yaml 预设航点），
       无决策核发目标时狗静止等待遥控/预设航点。 -->
  <arg name="global_planner" default="tare"/>
  <arg name="navi_mode_eff" value="$(eval '3' if global_planner == 'ariadne' else navi_mode)"/>
  <!-- 2026-08-26 两分支统一吃近距过滤云（原 tare 分支直吃原云已作废）：
       velodyne 360° 下视射线含狗体自回波，tare 首跑实证 grid_map 起点被自占
       阻塞 → A* 全败（bspline_optimizer.cpp:146 "a star error" 刷屏）→
       scan_planner_node 反复失败后 exit -6。旧「tare 吃原云保基线」是 livox
       时代结论，换装后未复测且已被今日实测推翻。 -->
  <arg name="scan_cloud" value="/mid360_points_clean"/>
  <arg name="init_x" default="-7.5"/>
  <arg name="init_y" default="0.5"/>
  <arg name="init_z" default="0.25"/>
  <arg name="init_yaw" default="0.0"/>
  <!-- 无头跑分开关（评估器/批量测试用）：gui:=false rviz:=false 省 CPU。
       默认 true 保持人工观察工作流不变。 -->
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <!-- 地形跟随 z（楼梯/多层场景如 depot 开启；默认关保持 indoor_1 基线） -->
  <arg name="terrain_follow" default="false"/>
  <!-- 高程数据源（2026-08-27）：仿真默认吃场景 GT 高程二进制（干净无天花板）；
       实机/感知路线用 terrain_source:=elevation。gt_elev_file 由场景 env.sh 提供 -->
  <arg name="terrain_source" default="gt_file"/>
  <arg name="gt_elev_file" default=""/>

  <!-- 1. Gazebo 场景 -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_file)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="$(eval not gui)"/>
  </include>

  <!-- spawn 狗模型（URDF 已含 mid360 LiDAR 插件） -->
  <param name="robot_description" textfile="$(find go2_description)/urdf/go2_description.urdf"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_go2"
        args="-param robot_description -urdf -model go2_description -x $(arg init_x) -y $(arg init_y) -z $(arg init_z) -Y $(arg init_yaw)
              -J FL_hip_joint 0.05 -J FL_thigh_joint 0.82 -J FL_calf_joint -1.58
              -J FR_hip_joint -0.05 -J FR_thigh_joint 0.82 -J FR_calf_joint -1.58
              -J RL_hip_joint 0.05 -J RL_thigh_joint 0.95 -J RL_calf_joint -1.62
              -J RR_hip_joint -0.05 -J RR_thigh_joint 0.95 -J RR_calf_joint -1.62"/>

  <!-- 2. ModelPlugin 是唯一模型位姿写入者；旧运动节点与 bridge 禁止同时启动 -->
  <param name="body_pose_topic" value="/quad_0/body_pose" type="str"/>
  <param name="init_x" value="$(arg init_x)" type="double"/>
  <param name="init_y" value="$(arg init_y)" type="double"/>
  <param name="init_z" value="$(arg init_z)" type="double"/>
  <!-- remote_drive:=true 时跳过闭环控制器：其无轨迹时以 100Hz 持续发零速 Twist
       （closed_loop_controller.cpp:175 publishStop / :241 timer 0.01s），会把遥控/
       stair_transit 直驱的 /cmd_vel 稀释（B 验收首跑实证：0.4m/s 指令被稀释至
       ~0.014m/s，780s 仅走 11m）。遥控验收与爬楼直驱场景必须关闭本节点。 -->
  <arg name="remote_drive" default="false"/>
  <node unless="$(arg remote_drive)" pkg="scan_planner" name="closed_loop_controller" type="closed_loop_controller" output="screen"/>

  <!-- 4. SCAN-Planner 主算法（mid360 点云已是世界系 -> cloud_is_world=true，免 sensor_pose 变换）
       点云源：两分支统一吃近距过滤后的 /mid360_points_clean（见顶部 scan_cloud 注释，
       2026-08-26 tare 分支改过滤云的根因记录）。 -->
  <include file="$(find scan_planner)/launch/advanced_param.xml">
    <arg name="is_real_world" value="false"/>
    <arg name="navi_mode" value="$(arg navi_mode_eff)"/>
    <arg name="sensor_type" value="lidar"/>
    <arg name="body_pose_topic" value="/quad_0/body_pose"/>
    <arg name="sensor_pose_topic" value="/quad_0/lidar_pose"/>
    <arg name="cloud_topic" value="$(arg scan_cloud)"/>
    <arg name="cloud_is_world" value="true"/>
    <arg name="depth_topic" value="/camera/aligned_depth_to_color/image_raw"/>
    <arg name="cx" value="321.04638671875"/>
    <arg name="cy" value="243.44969177246094"/>
    <arg name="fx" value="387.229248046875"/>
    <arg name="fy" value="387.229248046875"/>
  </include>

  <!-- 5. 狗模型 TF 显示 -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="go2_robot_state_publisher"/>
  <!-- 5b. /joint_states 发布（Track A1 修复，2026-08-29）：c33cedd 曾把 gait_publisher
       移出主栈（当时它经 gazebo_bridge→set_model_configuration 驱动 Gazebo 关节，是
       腿乱飞链路的一半；该桥已被 ModelPlugin 取代并封禁），但 ROS 侧从此无人发
       joint_states → RSP 拿不到 12 个 revolute 腿关节角 → RViz 41/44 link 缺 TF。
       本行恢复上游 SCAN-Planner 原版接线（a845c4a vendor 版 line65 即有）：
       静止发固定站姿（与 spawn -J / ModelPlugin CacheStandingJoints 同值），
       行走时发摆动步态——只进 RViz TF；Gazebo 侧关节仍由 ModelPlugin 每 tick
       钉站姿，两者物理上互不影响。fallback：integration/go2_bridge/scripts/
       go2_joint_state_publisher.py（无 body_pose 的纯静态场景用）。 -->
  <node pkg="scan_planner" name="go2_gait_publisher" type="go2_gait_publisher" output="screen"/>
  <!-- 狗总轨迹可视化：订阅 /quad_0/body_pose，累积发布 /odom_visualization/path（his_path） -->
  <node pkg="odom_visualization" type="odom_visualization" name="odom_visualization" output="screen"/>

  <!-- 6. 场景完整点云（ground truth，对照用）：GT 路径随场景切换 -->
  <arg name="gt_pcd" default="$(env HOME)/claude/raicom/go2-scan/maps/indoor_1.pcd"/>
  <node pkg="map_generator" type="map_pub" name="map_pub"
        args="$(arg gt_pcd)">
    <param name="frame_id" value="world"/>
    <param name="publish_rate" value="0.2"/>
    <param name="cloud_topic" value="/map"/>
    <param name="downsample_res" value="0.1"/>
  </node>

  <!-- 7. 累积扫描点云（scan_map）：mid360 -> 世界系累积。
       2026-08-26 两分支统一改回吃原始 /mid360_points：cloud_range_filter 的
       max_range=6 裁剪只服务 octomap「看不见=unknown」语义（frontier 复活修复，
       见 PROGRESS 2026-08-26 效用全零根因节）；建图层不应被连坐——比赛完整度
       评分依赖全量程建图（ray 物理量程 40m）。accumulator 自带
       min_range=0.3/max_range 过滤。历史动机「ariadne 吃 _clean 门控退化帧」
       是 livox 插件时代的防漂移措施，velodyne 换装 + spawn 健康门后已无此患。 -->
  <node pkg="go2_bridge" name="scan_cloud_accumulator" type="scan_cloud_accumulator.py" output="screen">
    <param name="max_range" value="40"/>
  </node>

  <!-- 8. RViz（GPU 硬件渲染：WSL2 的 OpenGL 走 D3D12 直通 NVIDIA，无需软件渲染） -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find scan_planner)/launch/default.rviz"/>

  <!-- 8b. 实时评分显示（2026-08-27）：增量 ER/路径/用时 → /live_score 文本 Marker，
       default.rviz 已加显示组。默认跟随 rviz 开关（无头跑分不起，零行为变化）。
       口径与官方评估器同款（import 复用其可见性函数），终值以评估器报告为准。 -->
  <arg name="live_score" default="$(arg rviz)"/>
  <node if="$(arg live_score)" pkg="go2_bridge" name="live_score_rviz" type="live_score_rviz.py" output="screen"/>

  <!-- 8c. 楼梯检测（方向④阶段C）：注册表兜底（橙箭头）+ 高程图几何检出（蓝箭头）。
       Depot 场景 env.sh 里自动开（stair_detect:=true）；indoor 等不开。 -->
  <arg name="stair_detect" default="false"/>
  <arg name="stair_registry" default="$(env HOME)/claude/raicom/go2-scan/scenes/depot/scene.yaml"/>
  <node if="$(arg stair_detect)" pkg="go2_bridge" name="stair_detector" type="stair_detector.py" output="screen">
    <param name="registry" value="$(arg stair_registry)"/>
  </node>

  <!-- 9. 2.5D 高程图（elevation_mapping：MID360 点云 + TF → 高程图，供楼梯检测/地形决策）
       cfg_dir 可被场景覆盖（Depot 等场景窗口中心与 indoor_1 不同） -->
  <arg name="cfg_dir" default="$(env HOME)/claude/raicom/go2-scan/simulation/elevation"/>
  <include file="$(env HOME)/claude/raicom/go2-scan/simulation/elevation/elevation.launch">
    <arg name="cfg_dir" value="$(arg cfg_dir)"/>
  </include>

  <!-- 10. 全局探索决策层（决定"往哪探索"），global_planner 选择：
       tare    -> TARE（默认）：way_point -> /move_base_simple/goal（navi_mode=1 追单点）
       ariadne -> ARiADNE（官方契约重做版，2026-08-24）：
                  建图+决策链在 rl_planner 包自带 launch 里（go2_ariadne.launch）：
                  点云转回传感器系+TF -> octomap(frame_id=map, map≡world 数值桥接)
                  -> /projected_map -> rl_planner(官方原版代码) -> /way_point
                  -> ariadne_goal_bridge 包装成 Path -> /initial_path -> SCAN navi_mode=3 局部规划。
                  运行：bash simulation/launch_gazebo_sim.sh global_planner:=ariadne -->

  <!-- 近距过滤两分支共用（2026-08-26 从 ariadne 组上提）：min_range 剔狗体自回波；
       max_range 分支差异化——ariadne=6 保 octomap「看不见=unknown」语义（效用全零
       根因修复，见 PROGRESS 2026-08-26）；tare=40 只滤近场，远场供建图/TARE 全量程输入。 -->
  <arg name="planner_sensor_range" value="$(eval '6' if global_planner == 'ariadne' else '40')"/>
  <node pkg="go2_bridge" name="cloud_range_filter" type="cloud_range_filter.py" output="screen">
    <param name="min_range" value="0.7"/>
    <param name="max_range" value="$(arg planner_sensor_range)"/>
  </node>

  <group if="$(eval global_planner == 'tare')">
    <!-- TARE：world 点云 -> /registered_scan + /state_estimation(_at_scan) 双发 -> 决策 -> /way_point -->
    <node pkg="go2_bridge" name="tare_bridge" type="tare_bridge.py" output="screen"/>
    <!-- 地形可通行性层（2026-08-25 补齐）：tare_planner 订阅 /terrain_map(+ext)。
         2026-08-26 站桩破案：CMU 两节点源码硬编码订阅 /state_estimation
         （terrainAnalysis.cpp:227 / terrainAnalysisExt.cpp:193），tare_bridge 现同时发
         /state_estimation 与 _at_scan 双份位姿。此前注释称「已产出」与源码不符，系误判——
         实际两节点饿死空转、TARE 永不规划、狗站桩（bench_tare 首跑实证）。 -->
    <include file="$(env HOME)/claude/raicom/go2-scan/simulation/cmu_env/src/terrain_analysis/launch/terrain_analysis.launch"/>
    <include file="$(env HOME)/claude/raicom/go2-scan/simulation/cmu_env/src/terrain_analysis_ext/launch/terrain_analysis_ext.launch"/>
    <node pkg="tare_planner" type="tare_planner_node" name="tare_planner_node" output="screen" ns="sensor_coverage_planner">
      <rosparam command="load" file="$(find tare_planner)/config/go2.yaml"/>
    </node>
    <node pkg="go2_bridge" name="navigation_boundary_publisher" type="navigation_boundary_publisher.py" output="screen"/>
    <!-- TARE 出口：/way_point -> /move_base_simple/goal（navi_mode=1 追单点） -->
    <node pkg="go2_bridge" name="tare_goal_bridge" type="tare_goal_bridge.py" output="screen"/>
  </group>

  <group if="$(eval global_planner == 'ariadne')">
    <!-- ARiADNE 建图+决策链：sensorScanGeneration + map→world 恒等桥 + octomap_server +
         rl_planner（官方原版 py）。接线契约依据见包内 launch 注释。 -->
    <include file="$(find rl_planner)/launch/go2_ariadne.launch"/>

    <!-- A2 出口：/way_point -> /initial_path（SCAN navi_mode=3），去重门控 -->
    <node pkg="go2_bridge" name="ariadne_goal_bridge" type="ariadne_goal_bridge.py" output="screen">
      <param name="repub_dist" value="1.0"/>
    </node>
  </group>
</launch>
