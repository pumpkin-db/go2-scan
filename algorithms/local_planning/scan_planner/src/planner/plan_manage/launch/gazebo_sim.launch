<launch>
  <!-- ============================================================ -->
  <!-- Gazebo 场景仿真：indoor_1.world + Go2 狗 + mid360 LiDAR     -->
  <!--   mid360 插件出 /mid360_points（传感器坐标）              -->
  <!--   go2_kinematic_sim 积分 /cmd_vel 出 /quad_0/body_pose        -->
  <!--   gazebo_bridge 把 body_pose 同步回 Gazebo（set_model_state） -->
  <!--                 并发布 /quad_0/lidar_pose 给 SCAN-Planner     -->
  <!-- ============================================================ -->

  <arg name="world_file" default="$(env HOME)/claude/raicom/go2-scan/simulation/worlds/indoor_1.world"/>
  <arg name="navi_mode" default="1"/>
  <!-- 全局决策层选择：tare（默认，行为与 2bf137d 基线完全一致）| ariadne。
       ariadne 时 navi_mode 自动切 3（SCAN /initial_path 模式）、点云源切 _clean -->
  <arg name="global_planner" default="tare"/>
  <arg name="navi_mode_eff" value="$(eval '3' if global_planner != 'tare' else navi_mode)"/>
  <arg name="scan_cloud" value="$(eval '/mid360_points_clean' if global_planner != 'tare' else '/mid360_points')"/>
  <arg name="init_x" default="-7.5"/>
  <arg name="init_y" default="0.5"/>
  <arg name="init_z" default="0.25"/>
  <arg name="init_yaw" default="0.0"/>

  <!-- 1. Gazebo 场景 -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_file)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
  </include>

  <!-- spawn 狗模型（URDF 已含 mid360 LiDAR 插件） -->
  <param name="robot_description" textfile="$(find go2_description)/urdf/go2_description.urdf"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_go2"
        args="-param robot_description -urdf -model go2_description -x $(arg init_x) -y $(arg init_y) -z $(arg init_z)"/>

  <!-- 2. 运动学仿真 + 控制器 -->
  <param name="body_pose_topic" value="/quad_0/body_pose" type="str"/>
  <param name="init_x" value="$(arg init_x)" type="double"/>
  <param name="init_y" value="$(arg init_y)" type="double"/>
  <param name="init_z" value="$(arg init_z)" type="double"/>
  <node pkg="scan_planner" name="go2_kinematic_sim" type="go2_kinematic_sim" output="screen">
    <param name="publish_tf" value="true"/>
    <param name="init_yaw" value="$(arg init_yaw)"/>
  </node>
  <node pkg="scan_planner" name="closed_loop_controller" type="closed_loop_controller" output="screen"/>

  <!-- 3. 桥：body_pose -> Gazebo set_model_state + sensor_pose -->
  <node pkg="go2_bridge" name="gazebo_bridge" type="gazebo_bridge.py" output="screen">
    <param name="lidar_z" value="0.2077"/>
  </node>

  <!-- 4. SCAN-Planner 主算法（mid360 点云已是世界系 -> cloud_is_world=true，免 sensor_pose 变换）
       点云源随分支切换：tare 用原始 /mid360_points（基线行为）；ariadne 用近距过滤后的
       /mid360_points_clean（octomap 链与 SCAN 同源，避免自体回波进占据地图）。 -->
  <include file="$(find scan_planner)/launch/advanced_param.xml">
    <arg name="is_real_world" value="false"/>
    <arg name="navi_mode" value="$(arg navi_mode_eff)"/>
    <arg name="sensor_type" value="lidar"/>
    <arg name="body_pose_topic" value="/quad_0/body_pose"/>
    <arg name="sensor_pose_topic" value="/quad_0/lidar_pose"/>
    <arg name="cloud_topic" value="$(arg scan_cloud)"/>
    <arg name="cloud_is_world" value="true"/>
    <arg name="depth_topic" value="/camera/aligned_depth_to_color/image_raw"/>
    <arg name="cx" value="321.04638671875"/>
    <arg name="cy" value="243.44969177246094"/>
    <arg name="fx" value="387.229248046875"/>
    <arg name="fy" value="387.229248046875"/>
  </include>

  <!-- 5. 狗模型 TF 显示 -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="go2_robot_state_publisher"/>
  <node pkg="scan_planner" name="go2_gait_publisher" type="go2_gait_publisher" output="screen"/>
  <!-- 狗总轨迹可视化：订阅 /quad_0/body_pose，累积发布 /odom_visualization/path（his_path） -->
  <node pkg="odom_visualization" type="odom_visualization" name="odom_visualization" output="screen"/>

  <!-- 6. 场景完整点云（ground truth，对照用）：map_pub 发布 indoor_1.pcd 到 /map -->
  <node pkg="map_generator" type="map_pub" name="map_pub"
        args="$(env HOME)/claude/raicom/go2-scan/maps/indoor_1.pcd">
    <param name="frame_id" value="world"/>
    <param name="publish_rate" value="0.2"/>
    <param name="cloud_topic" value="/map"/>
    <param name="downsample_res" value="0.1"/>
  </node>

  <!-- 7. 累积扫描点云（scan_map）：mid360 -> 世界系累积 -->
  <node pkg="go2_bridge" name="scan_cloud_accumulator" type="scan_cloud_accumulator.py" output="screen"/>

  <!-- 8. RViz（GPU 硬件渲染：WSL2 的 OpenGL 走 D3D12 直通 NVIDIA，无需软件渲染） -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find scan_planner)/launch/default.rviz"/>

  <!-- 9. 2.5D 高程图（elevation_mapping：MID360 点云 + TF → 高程图，供楼梯检测/地形决策） -->
  <include file="$(env HOME)/claude/raicom/go2-scan/simulation/elevation/elevation.launch"/>

  <!-- 10. 全局探索决策层（决定"往哪探索"），global_planner 选择：
       tare    -> TARE（默认）：way_point -> /move_base_simple/goal（navi_mode=1 追单点）
       ariadne -> ARiADNE（官方契约重做版，2026-08-24）：
                  建图+决策链在 rl_planner 包自带 launch 里（go2_ariadne.launch）：
                  点云转回传感器系+TF -> octomap(frame_id=map, map≡world 数值桥接)
                  -> /projected_map -> rl_planner(官方原版代码) -> /way_point
                  -> ariadne_goal_bridge 包装成 Path -> /initial_path -> SCAN navi_mode=3 局部规划。
                  运行：bash simulation/launch_gazebo_sim.sh global_planner:=ariadne -->
  <group if="$(eval global_planner == 'tare')">
    <!-- TARE：world 点云 -> /registered_scan + /state_estimation_at_scan -> 决策 -> /way_point -->
    <node pkg="go2_bridge" name="tare_bridge" type="tare_bridge.py" output="screen"/>
    <node pkg="tare_planner" type="tare_planner_node" name="tare_planner_node" output="screen" ns="sensor_coverage_planner">
      <rosparam command="load" file="$(find tare_planner)/config/go2.yaml"/>
    </node>
    <node pkg="go2_bridge" name="navigation_boundary_publisher" type="navigation_boundary_publisher.py" output="screen"/>
    <!-- TARE 出口：/way_point -> /move_base_simple/goal（navi_mode=1 追单点） -->
    <node pkg="go2_bridge" name="tare_goal_bridge" type="tare_goal_bridge.py" output="screen"/>
  </group>

  <group unless="$(eval global_planner == 'tare')">
    <!-- 近距过滤只在此分支启动：剔除传感器原点附近自体回波/零程退化点，
         否则污染 octomap 占据。TARE 路径不引入此节点，保持基线行为。 -->
    <node pkg="go2_bridge" name="cloud_range_filter" type="cloud_range_filter.py" output="screen">
      <param name="min_range" value="0.7"/>
    </node>

    <!-- ARiADNE 建图+决策链：sensorScanGeneration + map→world 恒等桥 + octomap_server +
         rl_planner（官方原版 py）。接线契约依据见包内 launch 注释。 -->
    <include file="$(find rl_planner)/launch/go2_ariadne.launch"/>

    <!-- A2 出口：/way_point -> /initial_path（SCAN navi_mode=3），去重门控 -->
    <node pkg="go2_bridge" name="ariadne_goal_bridge" type="ariadne_goal_bridge.py" output="screen">
      <param name="repub_dist" value="1.0"/>
    </node>
  </group>
</launch>
