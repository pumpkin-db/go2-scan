<launch>
  <!-- External-LIO integration template (ROS1). Defaults retain historical
       topic names; the LIO implementation, TF, and sensors are external. -->
  <arg name="body_pose_topic" default="/Odometry"/>
  <arg name="sensor_pose_topic" default="/Odometry"/>
  <arg name="cloud_topic" default="/cloud_registered"/>
  <arg name="cloud_is_world" default="true"/>
  <arg name="navi_mode" default="1"/>
  <arg name="sensor_type" default="lidar"/>

  <include file="$(find scan_planner)/launch/advanced_param.xml">
    <arg name="sensor_type" value="$(arg sensor_type)"/>
    <arg name="body_pose_topic" value="$(arg body_pose_topic)"/>
    <arg name="sensor_pose_topic" value="$(arg sensor_pose_topic)"/>
    <arg name="cloud_topic" value="$(arg cloud_topic)"/>
    <arg name="cloud_is_world" value="$(arg cloud_is_world)"/>
    <arg name="depth_topic" value="/camera/aligned_depth_to_color/image_raw"/>
    <arg name="cx" value="321.04638671875"/>
    <arg name="cy" value="243.44969177246094"/>
    <arg name="fx" value="387.229248046875"/>
    <arg name="fy" value="387.229248046875"/>
    <arg name="is_real_world" value="true"/>
    <arg name="navi_mode" value="$(arg navi_mode)"/>
  </include>

  <!-- SCAN trajectory tracking; final command uses the existing output chain. -->
  <node pkg="scan_planner" name="closed_loop_controller"
        type="closed_loop_controller" output="screen"/>
</launch>
